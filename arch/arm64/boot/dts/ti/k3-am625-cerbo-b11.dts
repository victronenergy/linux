/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>

#include "k3-am625-victron-revb.dtsi"

/ {
	model = "Cerbo GX";
	compatible = "victronenergy,cerbo-gx-b11",
		     "sancloud,am625-victron-revb",
		     "ti,am625";

	aliases {
		nvmem0 = &board_id;
		nvmem1 = &edid;
		nvmem2 = &som_eeprom;
		rtc0 = &rtc0;
		watchdog0 = &ext_wdt;
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";
		ddc-i2c-bus = <&mcu_i2c0>;

		port {
			hdmi_con: endpoint {
				remote-endpoint = <&hdmi_out>;
			};
		};
	};

	button {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&button_pins>;

		button {
			linux,code = <KEY_CONFIG>;
			gpios = <&main_gpio0 18 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_pins>;

		led-status-green {
			label = "status-green";
			gpios = <&main_gpio0 38 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-status-orange {
			label = "status-orange";
			gpios = <&main_gpio0 33 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "blink-slow";
		};

		led-bluetooth {
			label = "bluetooth";
			gpios = <&main_gpio0 40 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	buzzer {
		compatible = "pwm-beeper";
		pwms = <&epwm1 1 1000000 0>;
	};

	ext_wdt: watchdog {
		compatible = "linux,wdt-gpio";
		pinctrl-names = "default";
		pinctrl-0 = <&watchdog_pins>;
		hw_algo = "toggle";
		hw_margin_ms = <30000>;
		always-running;
		gpios = <&main_gpio0 67 GPIO_ACTIVE_HIGH>;
	};

	can_clk: can-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <40000000>;
	};
};

&main_pmx0 {
	mcp_can_pins: mcp-can-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x0084, PIN_INPUT, 7)	  /* L23 */
			AM62X_IOPAD(0x0098, PIN_INPUT, 7)	  /* U23 */
			AM62X_IOPAD(0x00a0, PIN_INPUT, 7)	  /* K25 */
		>;
	};

	ethphy_pins: ethphy-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x019c, PIN_OUTPUT, 7)	  /* B18 */
			AM62X_IOPAD(0x01f0, PIN_OUTPUT, 5)	  /* A18 */
		>;
	};

	touchscreen_pins: touchscreen-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x00a8, PIN_INPUT, 7)	  /* M21 */
		>;
	};

	led_pins: led-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x0088, PIN_OUTPUT, 7)	  /* L24 */
			AM62X_IOPAD(0x009c, PIN_OUTPUT, 7)	  /* V25 */
			AM62X_IOPAD(0x00a4, PIN_OUTPUT, 7)	  /* M22 */
		>;
	};

	watchdog_pins: watchdog-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x0110, PIN_OUTPUT, 7)	  /* C25 */
		>;
	};

	button_pins: button-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x0048, PIN_INPUT, 7)	  /* N25 */
		>;
	};

	epwm1_pins: epwm1-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x01a0, PIN_OUTPUT, 6)	  /* E18 */
		>;
	};

	main_gpio0_pins: main-gpio0-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x0114, PIN_INPUT, 7)	  /* B24 */
			AM62X_IOPAD(0x0120, PIN_INPUT, 7)	  /* C24 */
			AM62X_IOPAD(0x0168, PIN_INPUT, 7)	  /* AE21 */
		>;
	};

	main_gpio1_pins: main-gpio1-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x0190, PIN_INPUT, 7)	  /* AE22 */
			AM62X_IOPAD(0x01a8, PIN_INPUT, 7)	  /* D20 */
		>;
	};
};

&mcu_pmx0 {
	mcu_gpio0_pins: mcu-gpio0-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x001c, PIN_INPUT, 7)	  /* A6 */
			AM62X_IOPAD(0x003c, PIN_INPUT, 7)	  /* E5 */
			AM62X_IOPAD(0x0040, PIN_INPUT, 7)	  /* D4 */
		>;
	};
};

&main_i2c1 {
	adc@48 {
		compatible = "ti,tla2024";
		reg = <0x48>;
		#address-cells = <1>;
		#size-cells = <0>;

		channel@4 {
			reg = <4>;
		};

		channel@5 {
			reg = <5>;
		};

		channel@6 {
			reg = <6>;
		};

		channel@7 {
			reg = <7>;
		};
	};

	adc@49 {
		compatible = "ti,tla2024";
		reg = <0x49>;
		#address-cells = <1>;
		#size-cells = <0>;

		channel@4 {
			reg = <4>;
		};

		channel@5 {
			reg = <5>;
		};

		channel@6 {
			reg = <6>;
		};

		channel@7 {
			reg = <7>;
		};
	};
};

&main_i2c2 {
	board_id: eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <16>;
		read-only;
		vcc-supply = <&vdd_3v3>;
	};

	rtc0: rtc@68 {
		compatible = "nxp,pcf8523";
		status = "okay";
		reg = <0x68>;
	};
};

&mcu_i2c0 {
	touchscreen: touchscreen@38 {
		compatible = "edt,edt-ft5316", "edt,edt-ft5306";
		pinctrl-names = "default";
		pinctrl-0 = <&touchscreen_pins>;
		reg = <0x38>;
		interrupt-parent = <&main_gpio0>;
		interrupts = <41 IRQ_TYPE_EDGE_FALLING>;
	};

	edid: eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <16>;
		read-only;
		vcc-supply = <&vsys_5v0>;
	};

	backlight: backlight@51 {
		compatible = "victronenergy,gxdisp-backlight";
		reg = <0x51>;
		default-on;
		default-brightness = <15>;
	};
};

&hdmi_out {
	remote-endpoint = <&hdmi_con>;
};

&main_spi0 {
	mcp_can: can@0 {
		compatible = "microchip,mcp2518fd";
		pinctrl-names = "default";
		pinctrl-0 = <&mcp_can_pins>;
		reg = <0>;
		spi-max-frequency = <20000000>;
		clocks = <&can_clk>;
		interrupt-parent = <&main_gpio0>;
		interrupts = <32 IRQ_TYPE_EDGE_FALLING>;
		microchip,rx-int-gpios = <&main_gpio0 37 GPIO_ACTIVE_LOW>;
	};
};

&main_mcan0 {
	can-transceiver {
		max-bitrate = <2000000>;
	};
};

&cpsw_port1 {
	phy-handle = <&ethphy>;
};

&cpsw3g_mdio {
	ethphy: ethernet-phy@0 {
		compatible = "ethernet-phy-id0007.c0f0";
		pinctrl-names = "default";
		pinctrl-0 = <&ethphy_pins>;
		reg = <0>;
		clocks = <&k3_clks 157 20>;
		reset-gpios = <&main_gpio1 9 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <10000>;
		max-speed = <100>;
	};
};

&usb1 {
	wireless-controller@1 {
		compatible = "usbbda,d723";
		reg = <1>;
	};
};

&epwm1 {
	pinctrl-names = "default";
	pinctrl-0 = <&epwm1_pins>;
	status = "okay";
};

&main_gpio0 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_gpio0_pins>;
	gpio-line-names = "relay_1", "relay_2", "vebus_standby";
	gpio-line-numbers = <68>, <70>, <88>;
};

&main_gpio1 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_gpio1_pins>;
	gpio-line-names = "mkx_rst", "digital_input_4";
	gpio-line-numbers = <6>, <12>;
};

&mcu_gpio0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mcu_gpio0_pins>;
	gpio-line-names =
		"digital_input_3", "digital_input_1", "digital_input_2";
	gpio-line-numbers = <7>, <15>, <16>;
};
